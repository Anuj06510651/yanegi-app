/android/app/release
# Secrets — never commit
functions/.env
functions/.runtimeconfig.json

# Cloud Functions dependencies — restored with: cd functions && npm install
functions/node_modules/

# Flutter build outputs
/build/
.flutter-plugins
.flutter-plugins-dependencies
.dart_tool/

# iOS build
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# macOS
macos/Flutter/GeneratedPluginRegistrant.swift
macos/Flutter/Flutter-Debug.xcconfig
macos/Flutter/Flutter-Release.xcconfig

# Android build outputs
/android/app/debug
/android/app/profile
/android/app/release
android/.gradle/

# Added by code-review-graph
.code-review-graph/

# Claude Code / IDE
.claude/
.mcp.json
CLAUDE.md.backup
.vscode/

# Firebase CLI cache
.firebase/

# Android signing — NEVER commit keystores or their passwords
android/key.properties
*.jks
*.keystore
**/upload-keystore.jks
# Service accounts / admin credentials
**/serviceAccount*.json
**/*-service-account*.json
*.p12

# Catch every Gradle/Flutter build dir at any depth (root, android/, android/app/)
**/build/
